<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Payment Authorization</h1>
    <p class="text-muted">
      Authorize a payment method to subscribe to plans.
    </p>
  </div>

  <%= link_to "Browse Plans", plans_path, class: "btn btn-outline-primary" %>
</div>

<div class="card shadow-sm">
  <div class="card-body">

    <% if @payment_authorization&.authorized? %>

      <h5 class="card-title">Payment Authorization Completed</h5>

      <p class="text-success mb-2">
        Your payment method has been successfully authorized.
      </p>

      <p class="text-muted mb-0">
        You can now subscribe to available plans.
      </p>

    <% else %>

      <h5 class="card-title">Payment Authorization Required</h5>

      <p class="text-muted">
        Please authorize a payment method before subscribing to a plan.
      </p>

      <div
        data-controller="payment-authorization"
        data-payment-authorization-publishable-key-value="<%= @stripe_publishable_key %>"
      >

        <button
          type="button"
          class="btn btn-primary"
          data-payment-authorization-target="authorizeButton"
          data-action="click->payment-authorization#authorize"
        >
          Authorize Payment
        </button>

        <div
          class="mt-3"
          data-payment-authorization-target="paymentElement"
        ></div>

        <button
          type="button"
          class="btn btn-success mt-3"
          data-payment-authorization-target="submitButton"
          data-action="click->payment-authorization#submit"
          style="display: none;"
        >
          Confirm Payment Method
        </button>

        <p
          class="mt-3 mb-0"
          data-payment-authorization-target="message"
        ></p>

      </div>

    <% end %>

  </div>
</div>
