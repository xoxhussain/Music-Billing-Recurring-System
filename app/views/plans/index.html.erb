<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Available Plans</h1>
    <p class="text-muted mb-0">
      Choose a subscription plan for your music experience.
    </p>
  </div>

<%= link_to "My Subscriptions",
subscriptions_path,
class: "btn btn-outline-primary" %>

</div>

<div class="row g-4">
  <% @plans.each do |plan| %>
    <div class="col-md-6 col-xl-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column">


      <h4 class="card-title mb-2">
        <%= plan.name %>
      </h4>

      <h2 class="mb-3">
        <%= number_to_currency(plan.monthly_fee) %>
        <small class="text-muted fs-6">/ month</small>
      </h2>

      <% if plan.features.any? %>
        <h6 class="text-muted">Features</h6>

        <ul class="mb-4">
          <% plan.features.each do |feature| %>
            <li><%= feature.name %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted mb-4">
          No features listed.
        </p>
      <% end %>

      <div class="mt-auto">
        <%= button_to "Subscribe",
            subscriptions_path(plan_id: plan.id),
            method: :post,
            class: "btn btn-primary w-100" %>
      </div>

    </div>
  </div>
</div>

<% end %>

</div>
