<nav class="navbar navbar-dark bg-dark">
  <div class="container-fluid">


<%= link_to "Music App", plans_path, class: "navbar-brand" %>

<div class="d-flex align-items-center gap-3">

  <button class="btn btn-link text-white text-decoration-none p-0"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#profileOffcanvas"
          aria-controls="profileOffcanvas">

    <% if current_user.profile_photo.attached? %>
      <%= image_tag current_user.profile_photo,
          class: "rounded-circle",
          style: "width: 36px; height: 36px; object-fit: cover;" %>
    <% else %>
      <span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
            style="width: 36px; height: 36px;">
        <%= current_user.name.first.upcase %>
      </span>
    <% end %>

  </button>

</div>

  </div>
</nav>

<%= render "shared/profile_offcanvas" %>
