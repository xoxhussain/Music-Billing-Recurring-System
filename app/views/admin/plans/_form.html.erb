<%= form_with model: [:admin, plan] do |form| %>
  <% if plan.errors.any? %>
    <div class="alert alert-danger">
      <%= plan.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :monthly_fee, class: "form-label" %>
    <%= form.number_field :monthly_fee, step: "0.01", min: 0, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_plans_path, class: "btn btn-secondary" %>
<% end %>
