<%= form_with model: [:admin, feature] do |form| %>
  <% if feature.errors.any? %>
    <div class="alert alert-danger">
      <%= feature.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :code, class: "form-label" %>
    <%= form.text_field :code, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :unit_price, class: "form-label" %>
    <%= form.number_field :unit_price, step: 0.01, min: 0, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :max_unit_limit, class: "form-label" %>
    <%= form.number_field :max_unit_limit, min: 0, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
