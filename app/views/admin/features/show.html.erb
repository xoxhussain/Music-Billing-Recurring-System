<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Feature Details</h1>

  <div>
    <%= link_to "Edit", edit_admin_feature_path(@feature), class: "btn btn-primary" %>
    <%= link_to "Back", admin_features_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h3 class="card-title"><%= @feature.name %></h3>

    <p><strong>Code:</strong> <%= @feature.code %></p>
    <p><strong>Unit Price:</strong> <%= @feature.unit_price %></p>
    <p><strong>Maximum Unit Limit:</strong> <%= @feature.max_unit_limit %></p>
  </div>
</div>
