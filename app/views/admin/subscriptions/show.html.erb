<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Subscription Details</h1>

  <%= link_to "Back",
      admin_subscriptions_path,
      class: "btn btn-secondary" %>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <p>
      <strong>Buyer:</strong>
      <%= @subscription.user.name %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= @subscription.user.email %>
    </p>

    <p>
      <strong>Plan:</strong>
      <%= @subscription.plan.name %>
    </p>

    <p>
      <strong>Monthly Fee:</strong>
      <%= @subscription.plan.monthly_fee %>
    </p>

    <p>
      <strong>Started:</strong>
      <%= @subscription.started_at %>
    </p>

    <% status = @subscription.subscription_statuses.max_by(&:created_at) %>

    <p>
      <strong>Status:</strong>
      <span class="badge bg-primary">
        <%= status&.status&.humanize || "Unknown" %>
      </span>
    </p>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <h3>Current Usage</h3>

    <% usage = @subscription.usage_entries.group_by(&:plan_feature) %>

    <% if usage.any? %>
      <div class="table-responsive mt-3">
        <table class="table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Used Units</th>
              <th>Max Limit</th>
            </tr>
          </thead>

          <tbody>
            <% usage.each do |plan_feature, entries| %>
              <tr>
                <td><%= plan_feature.feature.name %></td>
                <td><%= entries.sum(&:quantity) %></td>
                <td>
                  <%= plan_feature.feature.max_unit_limit || "Unlimited" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">No usage recorded yet.</p>
    <% end %>
  </div>
</div>
